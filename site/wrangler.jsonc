// Сайт Arcade на Cloudflare Workers: статика из dist/ и код для сетевой игры (worker/index.js).
// dist/ собирает node build.mjs; правила кеширования — в dist/_headers, короткие адреса — в dist/_redirects.
{
  "name": "agent-arcade",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Адрес agent-arcade.<аккаунт>.workers.dev. Пробные адреса веток выключены: Cloudflare не делает их для Worker'ов с Durable Objects
  "workers_dev": true,
  "preview_urls": true, // предварительные копии веток: *-agent-arcade.fefaodessa.workers.dev
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Код вызывается только для сетевых адресов и корня / (плееру с Warzone 2100 — заголовки изоляции) — всю
    // остальную статику Cloudflare отдаёт сам, как раньше. "/" — только сам корень, без страниц под ним
    "run_worker_first": ["/", "/api/*", "/net/*"]
  },
  // Комнаты для сетевой игры и кеш поиска — Durable Objects на SQLite: они есть на бесплатном тарифе.
  // Поиску нужны секреты (wrangler secret put): LINK_SECRET — подпись ссылок, YOUTUBE_KEY — ключ YouTube Data API v3;
  // без них /api/discover отвечает 503, а мод берёт темы только из каталога.
  // Twitch — свой Durable Object и секреты TWITCH_CLIENT_ID и TWITCH_CLIENT_SECRET (приложение на dev.twitch.tv);
  // без них /api/twitch отвечает 503, а раздел Twitch в моде показывает каналы без эфиров.
  // Аккаунты — свой Durable Object Account: вход через GitHub по коду (worker/account.js); чаты друзей — Chat
  // (worker/chat.js), по экземпляру на чат; отчёты об ошибках — Reports (worker/reports.js), один на сайт;
  // общие доски проектов — Desk (worker/desk.js), по экземпляру на доску
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "DOOM", "class_name": "DoomRoom" },
      { "name": "EJS", "class_name": "EjsGame" },
      { "name": "PRESENCE", "class_name": "Presence" },
      { "name": "BOARD", "class_name": "BoardRoom" },
      { "name": "DISCOVER", "class_name": "Discover" },
      { "name": "TWITCH", "class_name": "Twitch" },
      { "name": "ACCOUNT", "class_name": "Account" },
      { "name": "CHAT", "class_name": "Chat" },
      { "name": "REPORTS", "class_name": "Reports" },
      { "name": "DESK", "class_name": "Desk" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["DoomRoom"] },
    { "tag": "v3", "new_sqlite_classes": ["EjsGame", "Presence"] },
    { "tag": "v4", "new_sqlite_classes": ["BoardRoom"] },
    // Кеш поиска по своей теме (worker/discover.js)
    { "tag": "v5", "new_sqlite_classes": ["Discover"] },
    // Кеш эфиров Twitch (worker/twitch.js)
    { "tag": "v6", "new_sqlite_classes": ["Twitch"] },
    // Аккаунты: вход через GitHub и настройки мода (worker/account.js)
    { "tag": "v7", "new_sqlite_classes": ["Account"] },
    // Чаты: переписка друзей один на один и в группах (worker/chat.js)
    { "tag": "v8", "new_sqlite_classes": ["Chat"] },
    // Отчёты об ошибках из мода (worker/reports.js)
    { "tag": "v9", "new_sqlite_classes": ["Reports"] },
    // Доски проектов: общие доски друзей (worker/desk.js)
    { "tag": "v10", "new_sqlite_classes": ["Desk"] }
  ],
  // Вход через GitHub: client ID приложения (OAuth App с Device Flow) — не секрет; client secret сайту не нужен.
  // ADMINS — номера GitHub тех, кто читает отчёты об ошибках (номер профиля публичный, не секрет)
  "vars": { "GITHUB_CLIENT_ID": "Ov23lihBdf0vldzRqVhv", "ADMINS": "92333314" },
  // Предварительные копии веток (wrangler preview): у каждой — свои Durable Objects, отдельно от рабочего сайта.
  // Код обращается к ним через env.ROOMS и т. д., поэтому привязки повторены здесь — иначе в копии ошибка 1101
  "previews": {
    "vars": { "GITHUB_CLIENT_ID": "Ov23lihBdf0vldzRqVhv", "ADMINS": "92333314" },
    "durable_objects": {
      "bindings": [
        { "name": "ROOMS", "class_name": "Room" },
        { "name": "DOOM", "class_name": "DoomRoom" },
        { "name": "EJS", "class_name": "EjsGame" },
        { "name": "PRESENCE", "class_name": "Presence" },
        { "name": "BOARD", "class_name": "BoardRoom" },
        { "name": "DISCOVER", "class_name": "Discover" },
        { "name": "TWITCH", "class_name": "Twitch" },
        { "name": "ACCOUNT", "class_name": "Account" },
        { "name": "CHAT", "class_name": "Chat" },
        { "name": "REPORTS", "class_name": "Reports" },
        { "name": "DESK", "class_name": "Desk" }
      ]
    }
  }
}
